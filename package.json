{
	"name": "ganezha",
	"private": true,
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"data": "bun run apps/profile/src/fetch-data.ts",
		"generate": "bun run apps/profile/src/generate.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"check": "bun run typecheck && bun run lint && bun run test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.3",
		"fast-check": "^4.10.2",
		"typescript": "5",
		"vitest": "^5.0.5"
	}
}
